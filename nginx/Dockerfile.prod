# === Stage 1: Spin up Python to compile Django static assets ===
FROM python:3.10-slim AS asset-compiler

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=kuakume.settings.prod

WORKDIR /build

RUN apt-get update && apt-get install -y \
    libpq-dev gcc python3-dev libjpeg-dev zlib1g-dev \
    libcairo2-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip pipenv

COPY ./kuakume /build/

RUN pipenv install --system --deploy

RUN python manage.py collectstatic --noinput

# === Stage 2: Inject compiled assets straight into Nginx ===
FROM nginx:1.25-alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY ./nginx/defaultpro.conf /etc/nginx/templates/default.conf.template

COPY --from=asset-compiler /build/kuakume/staticfiles/ /home/kuakume/staticfiles/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
